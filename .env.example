# ============================================================
# Automation Developer OS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# SUPABASE (Required for auth & database)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------------------------------------
# DATABASE (Required for Drizzle ORM migrations & connections)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
DATABASE_URL_UNPOOLED=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ------------------------------------------------------------
# AI LEARNING ASSISTANT (Optional - Enables live Senior Tutor AI)
# ------------------------------------------------------------
# Provide your OpenAI, Gemini, or Anthropic API Key here (Server-side ONLY)
AI_PROVIDER_API_KEY=YOUR_AI_PROVIDER_API_KEY
# Optional API endpoint override (Defaults to OpenAI Chat Completions: https://api.openai.com/v1/chat/completions)
AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# Optional Model name override (Defaults to gpt-4o-mini)
AI_MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------
# APP SETTINGS
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
